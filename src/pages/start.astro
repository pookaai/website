---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const highlights = [
  {
    title: "Business details",
    body: "What you do, who you serve, and the tools you already use day to day.",
  },
  {
    title: "Needs and wants",
    body: "Where time leaks, where leads stall, and what better would look like.",
  },
  {
    title: "Preferred follow-up times",
    body: "Share windows that work for you. We book the calendar manually after review.",
  },
];
---

<BaseLayout
  title="Tell us about your business, PookaAI"
  description="Share a few details about your business and what you want AI help with. We will follow up and book a time manually."
>
  <Header />
  <main id="main" class="pt-20">
    <section class="py-20 md:py-28">
      <div class="container-page">
        <div class="mx-auto max-w-3xl space-y-10 text-center">
          <div>
            <h1 class="text-4xl font-medium tracking-tight text-ink sm:text-5xl">
              Tell us about your business
            </h1>
            <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-ink-muted">
              A short form is the fastest way to get started. Share enough
              context that we can tell whether we can help. Then we
              will follow up and book time on the calendar manually.
            </p>
          </div>

          <div class="grid gap-6 text-left md:grid-cols-3">
            {highlights.map((item) => (
              <div class="space-y-2">
                <h2 class="text-base font-medium text-ink">{item.title}</h2>
                <p class="text-sm leading-relaxed text-ink-muted">{item.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-20 md:pb-28">
      <div class="container-page">
        <div class="mx-auto max-w-3xl">
          <form id="intake-form" class="space-y-8 border border-ink/10 p-6 sm:p-10">
            <div class="space-y-6">
              <div>
                <label for="name" class="block text-sm font-medium text-ink">
                  Your name <span class="text-ember">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="entry.209130737"
                  required
                  class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                />
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="email" class="block text-sm font-medium text-ink">
                    Email <span class="text-ember">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="entry.1448999132"
                    required
                    class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                  />
                </div>

                <div>
                  <label for="phone" class="block text-sm font-medium text-ink">
                    Phone
                  </label>
                  <input
                    type="text"
                    id="phone"
                    name="entry.1656494749"
                    class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                  />
                </div>
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="business-name" class="block text-sm font-medium text-ink">
                    Business name <span class="text-ember">*</span>
                  </label>
                  <input
                    type="text"
                    id="business-name"
                    name="entry.1185639137"
                    required
                    class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                  />
                </div>

                <div>
                  <label for="website" class="block text-sm font-medium text-ink">
                    Website
                  </label>
                  <input
                    type="text"
                    id="website"
                    name="entry.446718357"
                    class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label for="city" class="block text-sm font-medium text-ink">
                  City / service area <span class="text-ember">*</span>
                </label>
                <input
                  type="text"
                  id="city"
                  name="entry.2025350572"
                  required
                  class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                />
              </div>

              <div>
                <label for="business-type" class="block text-sm font-medium text-ink">
                  Business type <span class="text-ember">*</span>
                </label>
                <select
                  id="business-type"
                  name="entry.1299359423"
                  required
                  class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink focus:border-ink focus:outline-none"
                >
                  <option value="">Select one</option>
                  <option value="Home services / Trades">Home services / Trades</option>
                  <option value="Healthcare / local care">Healthcare / local care</option>
                  <option value="Professional services">Professional services</option>
                  <option value="Agency">Agency</option>
                  <option value="Retail / shop">Retail / shop</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div>
                <label for="what-business-does" class="block text-sm font-medium text-ink">
                  What does your business do? <span class="text-ember">*</span>
                </label>
                <textarea
                  id="what-business-does"
                  name="entry.608382910"
                  required
                  rows="3"
                  class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                ></textarea>
              </div>

              <div>
                <label for="biggest-friction" class="block text-sm font-medium text-ink">
                  What's the biggest friction right now? <span class="text-ember">*</span>
                </label>
                <textarea
                  id="biggest-friction"
                  name="entry.1505251189"
                  required
                  rows="3"
                  class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                ></textarea>
              </div>

              <div>
                <label for="ai-help" class="block text-sm font-medium text-ink">
                  What are you hoping AI or automation could help with? <span class="text-ember">*</span>
                </label>
                <textarea
                  id="ai-help"
                  name="entry.1866187892"
                  required
                  rows="3"
                  class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                ></textarea>
              </div>

              <div>
                <label for="tools" class="block text-sm font-medium text-ink">
                  Tools you use today
                </label>
                <textarea
                  id="tools"
                  name="entry.2013837544"
                  rows="3"
                  class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                ></textarea>
              </div>

              <div>
                <label for="preferred-times" class="block text-sm font-medium text-ink">
                  Preferred times for a follow-up chat <span class="text-ember">*</span>
                </label>
                <p class="mt-1 text-sm text-ink-muted">
                  e.g. Tue/Thu mornings CT, or specific windows next week
                </p>
                <textarea
                  id="preferred-times"
                  name="entry.83722286"
                  required
                  rows="3"
                  class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                ></textarea>
              </div>

              <div>
                <label for="anything-else" class="block text-sm font-medium text-ink">
                  Anything else we should know?
                </label>
                <textarea
                  id="anything-else"
                  name="entry.1834758167"
                  rows="3"
                  class="mt-2 w-full border border-ink/20 bg-canvas px-4 py-2 text-ink placeholder-ink-muted focus:border-ink focus:outline-none"
                ></textarea>
              </div>
            </div>

            <div class="space-y-4">
              <button
                type="submit"
                class="btn-primary w-full"
                id="submit-button"
              >
                Submit
              </button>
              <p id="form-message" class="text-center text-sm" style="display: none;"></p>
            </div>
          </form>

          <div id="thank-you" class="space-y-6 border border-ink/10 px-6 py-14 text-center sm:px-12" style="display: none;">
            <h2 class="text-2xl font-medium tracking-tight text-ink sm:text-3xl">
              Thanks for reaching out
            </h2>
            <p class="mx-auto max-w-xl text-base leading-relaxed text-ink-muted">
              We will review your submission and follow up by email to book a time that works for you.
            </p>
            <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
              <a class="btn-primary" href="/">Back to home</a>
            </div>
          </div>

          <p class="mt-6 text-center text-sm text-ink-muted">
            Prefer email?
            <a class="font-medium text-ink underline underline-offset-2 hover:text-ember" href="mailto:hello@pookaai.com">
              hello@pookaai.com
            </a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    document.getElementById('intake-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const form = e.target as HTMLFormElement;
      const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
      const formMessage = document.getElementById('form-message') as HTMLElement;
      const thankYou = document.getElementById('thank-you') as HTMLElement;
      
      submitButton.disabled = true;
      submitButton.textContent = 'Submitting...';
      formMessage.style.display = 'none';
      
      const formData = new FormData(form);
      const params = new URLSearchParams();
      
      formData.forEach((value, key) => {
        params.append(key, value.toString());
      });
      params.append('fvv', '1');
      
      try {
        await fetch('https://docs.google.com/forms/d/e/1FAIpQLSdcORxid6mfqaD9w6dw4h9ErcZZYWDEtCLT9Z8U_DU9yP4JJw/formResponse', {
          method: 'POST',
          mode: 'no-cors',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: params.toString(),
        });
        
        form.style.display = 'none';
        thankYou.style.display = 'block';
      } catch (error) {
        formMessage.textContent = 'Something went wrong. Please try again or email hello@pookaai.com';
        formMessage.className = 'text-center text-sm text-ember';
        formMessage.style.display = 'block';
        submitButton.disabled = false;
        submitButton.textContent = 'Submit';
      }
    });
  </script>
</BaseLayout>
