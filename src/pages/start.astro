---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Ops: replace with a real Google Forms embed URL, e.g.
// https://docs.google.com/forms/d/e/XXXX/viewform?embedded=true
const GOOGLE_FORM_EMBED_URL = "https://docs.google.com/forms/d/e/1FAIpQLSdcORxid6mfqaD9w6dw4h9ErcZZYWDEtCLT9Z8U_DU9yP4JJw/viewform?embedded=true";

const isPlaceholder =
  !GOOGLE_FORM_EMBED_URL ||
  GOOGLE_FORM_EMBED_URL === "ABOUT:BLANK_PLACEHOLDER" ||
  GOOGLE_FORM_EMBED_URL.startsWith("ABOUT:");

const highlights = [
  {
    title: "Business details",
    body: "What you do, who you serve, and the tools you already use day to day.",
  },
  {
    title: "Needs and wants",
    body: "Where time leaks, where leads stall, and what better would look like.",
  },
  {
    title: "Preferred follow-up times",
    body: "Share windows that work for you. Leigh books the calendar manually after review.",
  },
];
---

<BaseLayout
  title="Tell us about your business, PookaAI"
  description="Share a few details about your business and what you want AI help with. Leigh will follow up and book a time manually."
>
  <Header />
  <main id="main" class="pt-20">
    <section class="py-20 md:py-28">
      <div class="container-page">
        <div class="mx-auto max-w-4xl space-y-10">
          <div class="text-center">
            <h1 class="font-display text-4xl font-semibold tracking-tight text-offwhite sm:text-5xl">
              Tell us about your business
            </h1>
            <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-offwhite-muted">
              A short form is the fastest way to get started. Share enough
              context that we can tell whether we can help. Then Leigh
              will follow up and book time on the calendar manually.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-3">
            {highlights.map((item) => (
              <div class="space-y-2">
                <h2 class="font-display text-lg font-semibold text-offwhite">{item.title}</h2>
                <p class="text-sm leading-relaxed text-offwhite-muted">{item.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pb-20 md:pb-28">
      <div class="container-page">
        <div class="mx-auto max-w-4xl overflow-hidden border border-offwhite/5 bg-canvas-darker">
          {isPlaceholder ? (
            <div class="space-y-6 px-6 py-14 text-center sm:px-12">
              <h2 class="font-display text-2xl font-semibold tracking-tight text-offwhite sm:text-3xl">
                The intake form is not live yet
              </h2>
              <p class="mx-auto max-w-xl text-base leading-relaxed text-offwhite-muted">
                We are wiring up the Google Form now. In the meantime, email us
                with your business details, what you need help with, and a few
                preferred times for a follow-up.
              </p>
              <div class="flex flex-col items-center justify-center gap-6 sm:flex-row">
                <a
                  class="btn-primary"
                  href="mailto:hello@pookaai.com?subject=AI%20automation%20request&body=Hi%20PookaAI%2C%0A%0ABusiness%3A%0AWhat%20we%20do%3A%0ABiggest%20need%20or%20want%3A%0APreferred%20follow-up%20times%3A%0A"
                >
                  Email hello@pookaai.com
                </a>
                <a class="btn-ghost" href="/">Back to home</a>
              </div>
            </div>
          ) : (
            <div class="px-2 py-2 sm:px-4 sm:py-4">
              <iframe
                title="Tell us about your business"
                src={GOOGLE_FORM_EMBED_URL}
                class="w-full border-0"
                style="min-height: 1800px;"
                loading="lazy"
              >
                Loading…
              </iframe>
              <p class="px-4 pb-4 text-center text-sm text-offwhite-muted">
                Prefer email?
                <a class="font-medium text-offwhite underline underline-offset-2 hover:text-ember" href="mailto:hello@pookaai.com">
                  hello@pookaai.com
                </a>
              </p>
            </div>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
