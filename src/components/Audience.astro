---
const audiences = [
  "Home services & trades",
  "Clinics and local care practices",
  "Agencies with repeatable delivery",
  "Shops that sell services, not software",
];
---

<section id="who" class="bg-mist/80 py-20 md:py-24">
  <div class="container-page grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:items-center">
    <div>
      <p class="section-label">Who it's for</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Operators with real customers and finite hours
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-700">
        If your day is calls, jobs, follow-ups, and a tangle of tools, you're in the right place.
        We skip enterprise theater and aim for systems your team will actually use on Tuesday morning.
      </p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2">
      {audiences.map((item) => (
        <li class="rounded-3xl border border-ink-900/8 bg-cream px-5 py-4 text-sm font-semibold text-ink-800 shadow-card">
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
