---
const audiences = [
  "Home services and trades",
  "Clinics and local care practices",
  "Agencies with repeatable delivery",
  "Shops that sell services, not software",
];
---

<section id="who" class="py-32 md:py-40">
  <div class="container-page">
    <div class="mx-auto max-w-4xl space-y-10">
      <div>
        <h2 class="font-display text-4xl font-semibold tracking-tight text-offwhite sm:text-5xl">
          Who it's for
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-offwhite-muted">
          If your day is calls, jobs, follow-ups, and a tangle of tools, you're in the right place.
          We skip enterprise theater and aim for systems your team will actually use on Tuesday morning.
        </p>
      </div>
      <ul class="space-y-2 text-lg text-offwhite-muted">
        {audiences.map((item) => (
          <li class="border-l border-ember pl-4">{item}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
