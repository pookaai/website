---
const year = new Date().getFullYear();
---

<footer class="border-t border-offwhite/5 py-12">
  <div class="container-page">
    <div class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:justify-between md:text-left">
      <div class="space-y-3">
        <img
          src="/logo-lockup-white.svg"
          alt="PookaAI"
          width="120"
          height="32"
          class="h-8 w-auto"
          decoding="async"
        />
        <p class="text-sm text-offwhite-dim">
          AI automation for local and SMB service businesses.
        </p>
      </div>
      <div class="space-y-2 text-sm">
        <a class="block text-offwhite-muted transition hover:text-offwhite" href="mailto:hello@pookaai.com">hello@pookaai.com</a>
        <p class="text-offwhite-dim">© {year} PookaAI</p>
      </div>
    </div>
  </div>
</footer>
