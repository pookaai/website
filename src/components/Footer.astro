---
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 py-16">
  <div class="container-page">
    <div class="flex flex-col items-center gap-8 text-center md:flex-row md:items-start md:justify-between md:text-left">
      <div class="space-y-3">
        <img
          src="/logo-lockup.svg"
          alt="PookaAI"
          width="120"
          height="32"
          class="h-8 w-auto"
          decoding="async"
        />
        <p class="text-sm text-ink-muted">
          AI automation for local and SMB service businesses.
        </p>
      </div>
      <div class="space-y-2 text-sm">
        <a class="block text-ink-muted transition hover:text-ink" href="mailto:hello@pookaai.com">hello@pookaai.com</a>
        <p class="text-ink-muted">© {year} PookaAI</p>
      </div>
    </div>
  </div>
</footer>
