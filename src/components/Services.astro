---
const services = [
  {
    title: "AI business audits",
    body: "A grounded look at your ops, tools, and customer journey, then a short list of AI moves worth doing first.",
  },
  {
    title: "SaaS builds",
    body: "Custom lightweight apps when off the shelf tools bend the wrong way. Scoped tightly. Built to last.",
  },
  {
    title: "Customer voice & chat bots",
    body: "Phone and chat agents that answer common questions, capture leads, and book work without sounding robotic.",
  },
  {
    title: "AI automation workflows",
    body: "Connect the stack you already use. Trigger follow-ups, summarize jobs, route requests, keep humans in the loop.",
  },
  {
    title: "Websites",
    body: "Fast, clear sites that explain what you do and make it easy to get in touch, tuned for local service businesses.",
  },
];
---

<section id="services" class="py-20 md:py-24">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="section-label">Services</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Concrete help, not a mystery stack
      </h2>
      <p class="mt-4 text-lg text-ink-700">
        Start with an audit if you want orientation. Jump straight to a build if you already know the bottleneck.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {services.map((service, index) => (
        <article
          class:list={[
            "rounded-4xl border border-ink-900/8 bg-white p-6 shadow-card",
            index === 0 && "md:col-span-2 xl:col-span-1 bg-ink-900 text-cream border-ink-900",
          ]}
        >
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-2xl bg-ember-500/15 text-sm font-bold text-ember-700">
            {index === 0 ? <span class="text-ember-300">01</span> : String(index + 1).padStart(2, "0")}
          </div>
          <h3 class:list={["font-display text-xl font-semibold", index === 0 ? "text-cream" : "text-ink-900"]}>
            {service.title}
          </h3>
          <p class:list={["mt-3 text-sm leading-relaxed", index === 0 ? "text-ink-200" : "text-ink-600"]}>
            {service.body}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
