---
const services = [
  {
    title: "AI business audits",
    body: "A grounded look at your ops, tools, and customer journey, then a short list of AI moves worth doing first.",
  },
  {
    title: "SaaS builds",
    body: "Custom lightweight apps when off the shelf tools bend the wrong way. Scoped tightly. Built to last.",
  },
  {
    title: "Customer voice and chat bots",
    body: "Phone and chat agents that answer common questions, capture leads, and book work without sounding robotic.",
  },
  {
    title: "AI automation workflows",
    body: "Connect the stack you already use. Trigger follow-ups, summarize jobs, route requests, keep humans in the loop.",
  },
  {
    title: "Websites",
    body: "Fast, clear sites that explain what you do and make it easy to get in touch, tuned for local service businesses.",
  },
];
---

<section id="services" class="py-32 md:py-40">
  <div class="container-page">
    <div class="mx-auto max-w-4xl space-y-12">
      <div>
        <h2 class="font-display text-4xl font-semibold tracking-tight text-offwhite sm:text-5xl">
          What we build
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-offwhite-muted">
          Start with an audit if you want orientation. Jump straight to a build if you already know the bottleneck.
        </p>
      </div>

      <div class="space-y-1">
        {services.map((service) => (
          <div class="border-t border-offwhite/5 py-8">
            <h3 class="font-display text-2xl font-semibold text-offwhite">
              {service.title}
            </h3>
            <p class="mt-3 text-base leading-relaxed text-offwhite-muted">
              {service.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
