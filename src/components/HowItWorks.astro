---
const steps = [
  {
    title: "Audit",
    body: "We walk your current flow (leads, jobs, inbox, tools) and mark what AI can safely take off your plate.",
  },
  {
    title: "Prioritize",
    body: "You get a short ranked plan: quick wins first, bigger builds second, and a clear no list for later.",
  },
  {
    title: "Build and hand off",
    body: "We implement the chosen piece, test it with your team, document it in plain English, and leave you in control.",
  },
];
---

<section id="how" class="py-32 md:py-40">
  <div class="container-page">
    <div class="mx-auto max-w-4xl space-y-12">
      <div>
        <h2 class="font-display text-4xl font-semibold tracking-tight text-offwhite sm:text-5xl">
          How it works
        </h2>
      </div>

      <div class="space-y-8">
        {steps.map((step) => (
          <div class="border-t border-offwhite/5 pt-8">
            <h3 class="font-display text-2xl font-semibold text-offwhite">{step.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-offwhite-muted">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
