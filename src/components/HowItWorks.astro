---
const steps = [
  {
    title: "Audit",
    body: "We walk your current flow (leads, jobs, inbox, tools) and mark what AI can safely take off your plate.",
  },
  {
    title: "Prioritize",
    body: "You get a short ranked plan: quick wins first, bigger builds second, and a clear no list for later.",
  },
  {
    title: "Build & hand off",
    body: "We implement the chosen piece, test it with your team, document it in plain English, and leave you in control.",
  },
];
---

<section id="how" class="py-20 md:py-24">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="section-label">How it works</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl">
        Three steps. No fog machine.
      </h2>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {steps.map((step, index) => (
        <article class="relative rounded-4xl border border-ink-900/8 bg-white p-6 shadow-card">
          <p class="font-display text-5xl font-semibold text-ember-200">{String(index + 1).padStart(2, "0")}</p>
          <h3 class="mt-4 font-display text-2xl font-semibold text-ink-900">{step.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-600">{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
