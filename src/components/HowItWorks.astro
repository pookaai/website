---
const steps = [
  {
    title: "Audit",
    body: "We walk your current flow (leads, jobs, inbox, tools) and mark what AI can safely take off your plate.",
  },
  {
    title: "Prioritize",
    body: "You get a short ranked plan: quick wins first, bigger builds second, and a clear no list for later.",
  },
  {
    title: "Build and hand off",
    body: "We implement the chosen piece, test it with your team, document it in plain English, and leave you in control.",
  },
];
---

<section id="how" class="border-t border-ink/10 py-24 md:py-32">
  <div class="container-page">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center text-3xl font-medium tracking-tight text-ink sm:text-4xl">
        How it works
      </h2>

      <div class="mt-16 space-y-10">
        {steps.map((step) => (
          <div class="border-t border-ink/10 pt-8">
            <h3 class="text-xl font-medium text-ink">{step.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-muted">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
