---
const links = [
  { href: "/#services", label: "Services" },
  { href: "/start", label: "Start" },
];
---

<header class="fixed top-0 z-40 w-full border-b border-offwhite/5 bg-canvas/80 backdrop-blur-sm">
  <div class="container-page flex items-center justify-between gap-4 py-4">
    <a href="/" class="flex items-center gap-3" aria-label="PookaAI home">
      <img
        src="/logo-lockup-white.svg"
        alt="PookaAI"
        width="120"
        height="32"
        class="h-8 w-auto"
        decoding="async"
      />
    </a>

    <nav class="flex items-center gap-8" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} class="text-sm font-medium text-offwhite-muted transition hover:text-offwhite">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
